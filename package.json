{
  "name": "foil-and-fortune",
  "private": true,
  "version": "0.1.0",
  "description": "Foil & Fortune: a cozy collectibles-shop tycoon for the browser.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "tsx --tsconfig tsconfig.node.json scripts/content/validate.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run content:validate"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "fflate": "0.8.3",
    "howler": "2.2.4",
    "i18next": "26.4.2",
    "idb-keyval": "6.3.0",
    "immer": "11.1.18",
    "leva": "0.10.1",
    "lucide-react": "1.48.0",
    "maath": "0.10.8",
    "motion": "13.4.6",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "three": "0.186.1",
    "zod": "4.6.5",
    "zustand": "5.0.15",
    "zzfx": "1.3.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/howler": "2.2.13",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
